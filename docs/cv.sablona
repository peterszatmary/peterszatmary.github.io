#import "@preview/lavandula:0.1.1": *

#show: lavandula-theme

#set text(lang: "en")
#set document(
  title: "Peter Szatmary - Senior Java & Cloud Engineer (CV)",
  author: "Peter Szatmary",
  date: none,
)

#cv(
  sidebar-position: "left",
  sidebar-width: 35%,
  sidebar: [
    #align(center)[
      #box(
        width: 3.4cm,
        height: 3.4cm,
        radius: 50%,
        clip: true,
        fill: luma(220),
        stroke: 2.5pt + white,
        image("profile.jpg", width: 100%, height: 100%, fit: "cover")
      )
    ]
    #v(0.15cm)

    #align(center)[
      = Peter Szatmary
      #v(-0.4em)
      #text(weight: "semibold", size: sizes.text-b1, fill: rgb("#313131"))[Senior Java & Cloud Engineer] \
      #v(-0.2em)
      #text(size: sizes.text-s3, fill: luma(100))[B2B Contracts | Distributed Systems | Cloud & AI]
    ]
    #v(0.1cm)

    #contact-list((
      (icon: "envelope", icon-solid: true, text: link("mailto:peter.szatmary@gmail.com")[peter.szatmary\@gmail.com]),
      (icon: "phone", icon-solid: true, text: link("tel:+421944713969")[(+421) 944 713 969]),
      (icon: "location-dot", icon-solid: true, text: [Prague, Czech Republic]),
      (icon: "globe", text: link("https://peterszatmary.com")[peterszatmary.com]),
      (icon: "linkedin", text: link("https://linkedin.com/in/peter-szatmary")[in/peter-szatmary]),
      (icon: "github", text: link("https://github.com/peterszatmary")[github.com/peterszatmary]),
    ))

    #sidebar-section(title: "About me")[
      #set par(justify: true)
      #show par: it => block(width: 100%, it)

      Senior Software Engineer combining #highlight[13+ years of enterprise backend engineering] with high-level architectural design and modern #highlight[AI-augmented workflows].

      Experienced technical lead and DevOps advocate focused on #highlight[high availability], distributed event-driven systems, and accelerated software delivery. Available for #highlight[B2B contracts].
    ]

    #sidebar-section(title: "Core Stack")[
      #skill-group(
        name: "Backend & Systems",
        icon: "server",
        icon-solid: true,
        skills: (
          "Java 21",
          "Spring Boot",
          "Apache Kafka",
          "Spring REST",
          "Apache Flink",
          "Apache Spark",
          "Tomcat",
          "JBoss / WildFly",
